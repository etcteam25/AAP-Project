vmaccepteula

rootpw {{ esxi_root_password }}

{% if esxi_install_mode == 'firstdisk' %}
install --firstdisk={{ esxi_install_target }} --overwritevmfs
{% elif esxi_install_mode == 'disk' %}
install --disk={{ esxi_install_target }} --overwritevmfs
{% endif %}

network --bootproto=static --device={{ esxi_mgmt_nic | default('vmnic0') }} --ip={{ esxi_ip }} --netmask={{ esxi_netmask }} --gateway={{ esxi_gateway }} --nameserver={{ esxi_dns }} --hostname={{ esxi_hostname }}

reboot

%firstboot --interpreter=busybox

# Disable IPv6
esxcli network ip set --ipv6-enabled=false

# Apply the IPv6 change
sleep 10
reboot
